<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ meta.titulo }}</title>
<style>
  /* Geometría: A4 con 12 mm de margen. La caja útil es 186 x 273 mm; se trabaja
     sobre 255 mm de alto para dejar aire y que nada quede al filo del corte. */
  @page { size: A4; margin: 12mm; }

  /* Sistema visual: ficha de riesgo de cartera. Serif para la voz del informe, sans
     para la estructura y monoespaciada tabular para TODA cifra: eso alinea las columnas
     al comparar canales y le da el aire de libro de cartera. Solo fuentes del sistema,
     porque el archivo se abre sin conexión como adjunto de correo. */
  :root {
    --ink:#14181f; --muted:#6a6f78; --rule:#dfdbd4; --paper:#fff; --wash:#f7f4ef;
    --ia:#1f3d7a; --humano:#a8631b; --null:#8e939b; --alerta:#8c2f23;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  }
  * { box-sizing:border-box; }
  html { -webkit-print-color-adjust:exact; print-color-adjust:exact; color-scheme:light; }
  body {
    margin:0; background:#e9e5de; color:var(--ink); font-family:var(--sans);
    font-size:9.4pt; line-height:1.4; font-variant-numeric: tabular-nums lining-nums;
  }
  /* Sin overflow:hidden y con el pie en el flujo normal, a propósito: si el contenido
     desborda, fluye a una tercera página y `make verify` lo caza, en vez de recortarse o
     de quedar tapado por un pie posicionado encima. */
  .page {
    width:186mm; min-height:255mm; padding:0; margin:8mm auto; background:var(--paper);
    display:flex; flex-direction:column;
  }
  @media print {
    body { background:#fff; }
    .page { margin:0; width:auto; min-height:268mm; break-after:page; }
    .page:last-child { break-after:auto; }
  }

  /* ── Cabecera ─────────────────────────────────────────────────────────── */
  header { border-bottom:1.6px solid var(--ink); padding-bottom:2.2mm; margin-bottom:3.2mm; }
  .eyebrow {
    font-family:var(--mono); font-size:7.2pt; letter-spacing:.16em; text-transform:uppercase;
    color:var(--muted);
  }
  h1 {
    font-family:var(--serif); font-size:20.5pt; line-height:1.04; letter-spacing:-.012em;
    font-weight:600; margin:1.4mm 0 0; max-width:152mm; text-wrap:balance;
  }
  h2 {
    font-size:7.4pt; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);
    font-weight:650; margin:0 0 1.5mm; padding-bottom:.8mm; border-bottom:1px solid var(--rule);
  }
  p { margin:0 0 1.5mm; }
  section { margin-bottom:2.6mm; }

  .verdict { font-family:var(--serif); font-size:11pt; line-height:1.33; margin:0 0 3.2mm; }
  .verdict strong { font-weight:650; }

  /* ── Cuadro de mando: la cifra, la etiqueta y la brecha dibujada ──────── */
  .kpis { display:grid; grid-template-columns:repeat({{ kpis|length }},1fr); gap:4mm; }
  .kpi { border-top:2px solid var(--ia); padding-top:1.3mm; }
  .kpi.neg { border-top-color:var(--humano); }
  .kpi.null { border-top-color:var(--null); }
  .kpi .v {
    font-family:var(--mono); font-size:13pt; font-weight:600; letter-spacing:-.03em;
    display:block; line-height:1.05;
  }
  .kpi.null .v { color:var(--muted); }
  .kpi .l { font-size:7.6pt; color:var(--muted); display:block; margin-top:.6mm; }
  svg.gap { width:100%; height:3.2mm; margin-top:.7mm; display:block; }
  .gap-track { stroke:var(--rule); stroke-width:1.4; }
  .gap-span { stroke:#cfc9c0; stroke-width:1.4; }
  .gap-mark.ai { fill:var(--ia); }
  .gap-mark.human { fill:var(--humano); }
  .legend { font-size:7.2pt; color:var(--muted); margin:1mm 0 0; }
  .legend .dot { color:var(--ia); }
  .legend .dia { color:var(--humano); }

  /* ── Semáforo de cumplimiento: el bloque que el banco mira primero ────── */
  .risk {
    border:1px solid var(--rule); border-left:3px solid var(--alerta); background:var(--wash);
    padding:2.2mm 3mm 1.8mm;
  }
  .risk h2 { color:var(--alerta); border-bottom-color:#e6d8d4; }
  .risk td:first-child { font-weight:600; }
  .risk .note { margin:1mm 0 0; border-left-color:#e6d8d4; }

  /* ── Tablas ───────────────────────────────────────────────────────────── */
  table { width:100%; border-collapse:collapse; font-size:8.3pt; }
  th {
    text-align:left; font-weight:650; color:var(--muted); font-size:7pt; text-transform:uppercase;
    letter-spacing:.08em; padding:.8mm 1.4mm; border-bottom:1px solid var(--ink);
  }
  td { padding:.7mm 1.4mm; border-bottom:1px solid var(--rule); vertical-align:top; }
  tr:last-child td { border-bottom:0; }
  td.num { text-align:right; white-space:nowrap; font-family:var(--mono); }
  th.num { text-align:right; white-space:nowrap; }
  table.compact { width:64%; }

  .tag { font-family:var(--mono); font-size:7pt; padding:.3mm 1.2mm; border-radius:1px;
         background:#efece6; color:var(--muted); white-space:nowrap; }
  .tag.ok { background:#e7eef0; color:#1f4f52; }
  .tag.ko { background:#f4e7e3; color:var(--alerta); }
  .tag.warn { background:#f6eddb; color:#7a5310; }

  /* ── Forest plot: color y forma dicen lo mismo, para que sirva impreso ── */
  svg.forest { width:100%; height:auto; }
  .forest .axis-zero { stroke:var(--ink); stroke-width:1.1; }
  .forest .axis-tick { stroke:var(--rule); stroke-width:1; }
  .forest .axis-label { font-family:var(--mono); font-size:7px; fill:var(--muted); text-anchor:middle; }
  .forest .axis-title { font-size:7px; fill:var(--muted); text-anchor:middle; }
  .forest .row-label { font-size:8.3px; fill:var(--ink); text-anchor:end; }
  .forest .row-value { font-family:var(--mono); font-size:8.3px; font-weight:600; text-anchor:end;
                       stroke:none; }
  .forest .ci { stroke-width:2; stroke-linecap:round; }
  .forest .pos { stroke:var(--ia); fill:var(--ia); }
  .forest .neg { stroke:var(--humano); fill:var(--humano); }
  .forest .null { stroke:var(--null); fill:var(--null); }
  .forest .pt.tentative { fill:var(--paper); stroke-width:1.8; }
  .forest .ci.tentative { stroke-dasharray:3 2; }

  /* ── Hallazgos ────────────────────────────────────────────────────────── */
  ol.findings { margin:0; padding:0; list-style:none; counter-reset:f; }
  ol.findings li {
    counter-increment:f; padding:1.2mm 0 1.2mm 7mm; border-bottom:1px solid var(--rule);
    position:relative;
  }
  ol.findings li:last-child { border-bottom:0; }
  ol.findings li::before {
    content:counter(f); position:absolute; left:0; top:1.2mm; font-family:var(--mono);
    font-size:7.6pt; font-weight:700; color:var(--ia); border-bottom:1.4px solid var(--ia);
    width:4.6mm; text-align:center; padding-bottom:.2mm;
  }
  ol.findings .claim { font-weight:620; }
  ol.findings .why { color:var(--muted); }
  ol.findings .action { display:block; margin-top:.5mm; font-size:8.6pt; color:var(--ia); }

  /* ── Listas, notas y pie ──────────────────────────────────────────────── */
  ul.levers, ul.bullets { margin:0; padding-left:3.6mm; }
  ul.levers li { margin-bottom:.9mm; }
  ul.bullets li { margin-bottom:.7mm; }
  .note { font-size:7.9pt; color:var(--muted); border-left:2px solid var(--rule); padding-left:2.4mm; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:5mm; }
  footer {
    margin-top:auto; font-family:var(--mono); font-size:7.2pt; color:var(--muted);
    border-top:1px solid var(--rule); padding-top:1.4mm; display:flex; justify-content:space-between;
  }
  footer a { color:inherit; text-decoration:none; }
</style>
</head>
<body>

<div class="page" id="p1">
  <header>
    <div class="eyebrow">{{ meta.cliente }} · {{ meta.fecha }}</div>
    <h1>{{ meta.titulo }}</h1>
  </header>

  <p class="verdict">{{ veredicto|safe }}</p>

  <section>
    <div class="kpis">
      {% for k in kpis %}<div class="kpi {{ k.clase }}"><span class="v">{{ k.valor }}</span><span class="l">{{ k.etiqueta }}</span>{{ k.barra|safe }}</div>{% endfor %}
    </div>
    <p class="legend"><span class="dot">●</span> IA · <span class="dia">◆</span> humanos, sobre 50 llamadas por canal</p>
  </section>

  <section class="risk">
    <h2>{{ cumplimiento.rotulo }}</h2>
    <table>
      <thead><tr><th>Conducta</th><th class="num">IA</th><th class="num">Humanos</th>
        <th>Norma</th><th>Qué hacer</th></tr></thead>
      <tbody>
      {% for a in cumplimiento.filas %}
        <tr><td>{{ a.conducta }}</td><td class="num">{{ a.ia }}</td><td class="num">{{ a.humano }}</td>
            <td>{{ a.norma }}</td><td>{{ a.accion }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ cumplimiento.advertencia }}</p>
  </section>

  <section>
    <h2>Dónde difieren, y cuánto</h2>
    {{ forest_svg|safe }}
    <p class="note">{{ forest_nota }}</p>
  </section>

  <section>
    <h2>Hallazgos</h2>
    <ol class="findings">
      {% for f in hallazgos %}
      <li><span class="claim">{{ f.claim }}</span> <span class="why">{{ f.why }}</span>
        <span class="action">→ {{ f.accion }}</span></li>
      {% endfor %}
    </ol>
  </section>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span>1 / 2</span></footer>
</div>

<div class="page" id="p2">
  <header>
    <div class="eyebrow">Evidencia y método</div>
  </header>

  <section>
    <h2>Lo que el banco necesita y cuándo lo tendrá</h2>
    <table>
      <thead><tr><th>Indicador</th><th>Hoy, desde la grabación</th><th>Con el piloto</th>
        <th>En producción</th></tr></thead>
      <tbody>
      {% for k in kpis_banco %}
        <tr><td>{{ k.kpi }}</td><td>{{ k.hoy }}</td><td>{{ k.piloto }}</td><td>{{ k.produccion }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>¿Eran llamadas comparables?</h2>
    <table class="compact">
      <thead><tr><th>Contexto de la llamada</th><th class="num">IA</th><th class="num">Humanos</th></tr></thead>
      <tbody>
      {% for c in composicion %}
        <tr><td>{{ c.etiqueta }}</td><td class="num">{{ c.ia }}</td><td class="num">{{ c.humano }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ composicion_nota|safe }}</p>
  </section>

  <div class="grid2">
    <section>
      <h2>Método</h2>
      <ul class="bullets">{% for m in metodo %}<li>{{ m|safe }}</li>{% endfor %}</ul>
    </section>
    <section>
      <h2>Qué no se pudo medir</h2>
      <ul class="bullets">{% for l in limitaciones %}<li>{{ l|safe }}</li>{% endfor %}</ul>
    </section>
  </div>

  <section>
    <h2>Siguiente paso</h2>
    <ul class="levers">
      {% for p in palancas %}<li><strong>{{ p.titulo }}</strong> {{ p.detalle }}</li>{% endfor %}
    </ul>
    <p class="note">{{ escala }}</p>
  </section>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span>2 / 2</span></footer>
</div>

</body>
</html>
