<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ meta.titulo }}</title>
<style>
{{ fuentes|safe }}
  /* Geometría: A4 con 10 mm de margen. La caja útil es 190 x 277 mm; la página se trabaja
     sobre 272 mm de alto para que nada quede al filo del corte. El margen no es cosmético:
     con 12 mm la página 1 solo admitía 2 mm más de texto antes de romperse en tres páginas.
     10 mm sigue lejos de la zona no imprimible (≤6,4 mm). */
  @page { size: A4; margin: 10mm; }

  /* Sistema visual: la identidad de Creceré AI, aplicada con una regla que lo gobierna todo.

     **El rosa es identidad, no información.** Su rosa de marca (#f06ecf) tiene 2,67:1 de
     contraste sobre blanco: no pasa ni el umbral de 3:1 para elementos gráficos, así que no
     puede llevar texto, ni una serie, ni un filete que signifique algo. Va como firma y nada
     más. Donde la familia rosa tiene que leerse se usa #7a2c68, que da 8,8:1.

     Los colores de los datos no son de marca, son de legibilidad: el informe se fotocopia y
     las dos series necesitan separarse en gris. Azul y ocre están a 21,8 de ΔL*; el magenta
     secundario de la marca y el ocre están a 2,5, indistinguibles, así que ese no entra.

     Poppins es la tipografía del sistema de Creceré y va embebida, pero solo en los títulos
     y rótulos: en cuerpo pequeño sus contraformas circulares pierden legibilidad y ocupa más
     ancho del que caben dos páginas. La identidad está donde se ve; la economía, donde se lee. */
  :root {
    --ink:#1f1f1f; --muted:#737373; --rule:#e6e6e6; --paper:#fff; --wash:#fafafa;
    --marca:#f06ecf; --marca-tinta:#7a2c68;
    --ia:#1f3d7a; --humano:#a8631b; --null:#6f747c; --alerta:#8c2f23;
    --display: Poppins, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
            "Liberation Sans", sans-serif;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    /* Tres pesos de filete y nada más: el fuerte abre bloque, el fino cierra tabla y separa
       columnas, el de tinta a un píxel sostiene la cabecera y el pie. */
    --filete-fuerte: .55mm solid var(--ink);
    --filete-medio: .3mm solid var(--ink);
    --filete-fino: 1px solid var(--rule);
  }
  * { box-sizing:border-box; }
  html { -webkit-print-color-adjust:exact; print-color-adjust:exact; color-scheme:light; }
  body {
    margin:0; background:#e9e5de; color:var(--ink); font-family:var(--sans);
    font-size:9.4pt; line-height:1.4; font-variant-numeric: tabular-nums lining-nums;
  }
  /* En pantalla se muestra la hoja entera (210 x 297) con sus 10 mm de margen, para que
     cada línea parta donde va a partir impresa. La caja de contenido mide 272 mm en los dos
     medios, así que el pie cae a la misma altura en el navegador y en el PDF.
     Sin overflow:hidden y con el pie en el flujo normal, a propósito: si el contenido
     desborda, fluye a una tercera página y `make verify` lo caza, en vez de recortarse o
     de quedar tapado por un pie posicionado encima. */
  .page {
    width:210mm; min-height:297mm; padding:10mm 10mm 15mm; margin:8mm auto;
    background:var(--paper); display:flex; flex-direction:column;
    box-shadow:0 .5mm 2mm rgba(0,0,0,.14);
  }
  @media print {
    body { background:#fff; }
    .page { margin:0; width:auto; min-height:272mm; padding:0; box-shadow:none; break-after:page; }
    .page:last-child { break-after:auto; }
  }

  /* ── Cabecera: filete de marca, línea de identificación y título ──────────
     Es la misma en las dos páginas —marca arriba, tinta abajo, fecha a la derecha—: lo que
     convierte dos hojas sueltas en un documento es que compartan cabecera y pie. */
  header { border-top:1.1mm solid var(--marca); border-bottom:var(--filete-medio);
           padding:2.4mm 0 2.4mm; margin-bottom:0; }
  #p2 header { margin-bottom:2.8mm; }
  .eyebrow {
    display:flex; justify-content:space-between; gap:6mm;
    font-family:var(--display); font-size:7.2pt; font-weight:600; letter-spacing:.25em;
    text-transform:uppercase; color:var(--marca-tinta); line-height:1.3;
  }
  .eyebrow span:last-child { color:var(--muted); }
  h1 {
    font-family:var(--display); font-size:19.5pt; line-height:1.1; letter-spacing:-.02em;
    font-weight:600; margin:2.6mm 0 .6mm; max-width:158mm; text-wrap:balance;
  }
  h2 {
    font-family:var(--display); font-size:7pt; letter-spacing:.2em; text-transform:uppercase;
    color:var(--marca-tinta); font-weight:600; margin:0 0 1.6mm; padding-bottom:.9mm;
    border-bottom:var(--filete-fino);
  }
  /* Rótulo mayor: lo que el lector necesita y lo que tiene que hacer. */
  h2.major { font-size:8pt; color:var(--ink); }
  p { margin:0 0 1.5mm; }
  p, li { orphans:2; widows:2; }

  /* ── La decisión, en tres escalones ──────────────────────────────────────
     Veredicto a 12,6 pt, recomendación a 10,8 pt en negrita, tabla a 8,3 pt: el ojo baja
     por tamaño y peso, y el aire entre ellos es el que separa tres cosas distintas. Ninguno
     lleva filete lateral: con él tenía traje de cita, y una cita se salta. */
  .verdict {
    font-size:12.6pt; line-height:1.32; margin:5.5mm 0 4mm; max-width:172mm; text-wrap:pretty;
  }
  .verdict strong { font-weight:650; }
  /* La única instrucción del documento: cuelga de un filete propio y no la cierra ninguno,
     para que el bloque de alertas de abajo no la encajone. */
  .ask {
    font-size:10.8pt; font-weight:600; line-height:1.3; margin:0 0 6mm;
    padding:2.4mm 18mm 0 0; border-top:var(--filete-medio); text-wrap:pretty;
  }

  /* ── Alertas de cumplimiento: el bloque que el banco mira primero ─────── */
  .risk { border-top:var(--filete-fuerte); padding-top:2mm; margin-bottom:4.5mm; }
  .risk h2 { color:var(--alerta); border-bottom:0; padding-bottom:0; margin-bottom:1mm; }
  /* La frase que protege a quien presenta el papel, pegada a la tabla y en cuerpo de
     lectura: lo que se fotografía y se reenvía es la tabla, nunca el pie. */
  .risk .caveat { font-size:8.4pt; margin:0 0 2mm; max-width:172mm; }

  /* ── Tablas: filete fuerte abre, fino separa filas, medio cierra ────────── */
  table { width:100%; border-collapse:collapse; font-size:8.3pt; line-height:1.34; }
  th {
    text-align:left; font-family:var(--display); font-weight:600; color:var(--muted);
    font-size:6.6pt; letter-spacing:.14em; text-transform:uppercase; line-height:1.2;
    padding:0 1.6mm 1.1mm; border-bottom:var(--filete-medio); vertical-align:bottom;
  }
  td { padding:1.4mm 1.6mm 1.6mm; border-bottom:var(--filete-fino); vertical-align:top;
       hyphens:none; }
  tbody tr:last-child td { border-bottom:var(--filete-medio); }
  td.num, th.num { text-align:right; white-space:nowrap; }
  td.num { font-family:var(--mono); }
  /* El número de fila cuelga en una columna propia: rótulo y cita comparten borde izquierdo. */
  td.n { font-family:var(--mono); color:var(--muted); font-size:7.4pt; padding-left:0;
         padding-right:0; }
  th:first-child, td:first-child { padding-left:0; }
  th:last-child, td:last-child { padding-right:0; }

  /* La cita literal es la evidencia: en tinta, cursiva y al cuerpo de la tabla, con la
     comilla colgada al margen para que el texto quede a plomo con el rótulo que sostiene. */
  .risk .conducta { display:block; font-weight:600; }
  .risk .cita {
    display:block; font-style:italic; font-size:8.2pt; line-height:1.34; color:var(--ink);
    margin:.5mm 0 0 -1.7mm; padding-left:1.7mm; text-indent:-1.7mm; text-wrap:pretty;
  }
  .risk .accion { display:block; }
  .risk .arreglo { display:block; color:var(--muted); margin-top:.5mm; }
  /* La norma en el cuerpo, no en monoespaciada: es una referencia legal, no una cifra. */
  .risk .norma { font-size:7.4pt; color:var(--muted); line-height:1.4; display:block;
                 padding-top:.2mm; }
  .risk .note { margin:1.6mm 0 0; }

  /* ── Forest plot: color y forma dicen lo mismo, para que sirva impreso ── */
  svg.forest { width:100%; height:auto; display:block; margin-top:.5mm; }
  .forest .axis-zero { stroke:var(--ink); stroke-width:1.1; }
  .forest .axis-tick { stroke:var(--rule); stroke-width:1; }
  .forest .axis-label { font-family:var(--mono); font-size:7.4px; fill:var(--muted); text-anchor:middle; }
  .forest .axis-title { font-size:7.4px; fill:var(--muted); text-anchor:middle; }
  .forest .row-label { font-size:8.3px; fill:var(--ink); text-anchor:end; }
  .forest .row-value { font-family:var(--mono); font-size:8.3px; font-weight:600; text-anchor:end; }
  .forest .ci { stroke-width:2; stroke-linecap:round; }
  .forest .ci.null { stroke-width:1.1; }  /* la conclusividad no puede ir solo en el tono */
  .forest .pos { stroke:var(--ia); fill:var(--ia); }
  .forest .neg { stroke:var(--humano); fill:var(--humano); }
  .forest .null { stroke:var(--null); fill:var(--null); }
  /* .pos/.neg/.null llevan stroke para las líneas y los puntos, y por cascada se lo imponían
     también al texto: a 8,3 px el contorno cerraba los ojos del 8 y del 6. */
  .forest .row-value, .forest .row-label { stroke:none; }

  /* ── El recorrido: una regla de 0 a 50 y tres paneles medidos contra ella ─
     Los tres capítulos comparten rótulo (el mismo que las secciones), marco de 50 con borde,
     y conteo al final en el color de su serie: lo que cambia es el dato, no el traje. */
  svg.recorrido { width:100%; height:auto; display:block; margin-top:1.5mm; }
  .journey .lead { font-size:8.6pt; color:var(--ink); margin:0 0 1mm; max-width:172mm; text-wrap:pretty; }
  .rc-rule { stroke:var(--ink); stroke-width:.9; }
  .rc-tick { font-family:var(--mono); font-size:7px; fill:var(--muted); }
  .rc-frame { fill:#f2f2f2; stroke:#dedede; stroke-width:.4; }
  .rc-tag { font-family:var(--mono); font-size:6.8px; font-weight:600; fill:var(--muted); }
  .rc-bar.ia.solid { fill:var(--ia); }
  .rc-bar.human.solid { fill:var(--humano); }
  .rc-bar.ia.hatch { fill:url(#rc-hatch-ia); }
  .rc-bar.human.hatch { fill:url(#rc-hatch-human); }
  .rc-hatch.ia { stroke:var(--ia); stroke-width:1.6; }
  .rc-hatch.human { stroke:var(--humano); stroke-width:1.6; }
  .rc-bar.ia.hollow { fill:var(--paper); stroke:var(--ia); stroke-width:.9; }
  .rc-bar.human.hollow { fill:var(--paper); stroke:var(--humano); stroke-width:.9; }
  .rc-bar.dots { fill:#d9d9d9; }
  .rc-zero.ia { fill:var(--ia); }
  .rc-zero.human { fill:var(--humano); }
  .rc-count { font-family:var(--mono); font-size:8.6px; font-weight:600; }
  .rc-count.ia { fill:var(--ia); }
  .rc-count.human { fill:var(--humano); }
  .rc-label { font-size:8.3px; fill:var(--ink); }
  .rc-title { font-family:var(--display); font-size:7.2px; font-weight:600; letter-spacing:.2em;
              text-transform:uppercase; fill:var(--marca-tinta); }
  .rc-legend { font-size:7px; fill:var(--ink); }
  .rc-swatch.solid { fill:var(--ink); }
  .rc-swatch.hatch { fill:#8a8a8a; }
  .rc-swatch.hollow { fill:#ffffff; stroke:var(--ink); stroke-width:.5; }
  .rc-swatch.dots { fill:#d9d9d9; }
  .rc-caption { font-size:7.2px; fill:var(--muted); }

  /* ── El cierre como calendario: tres columnas por plazo, el tiempo de izquierda a derecha ─
     Un filete fuerte encima de las tres, la fila de plazos cerrada por un fino que corre de
     columna a columna y un fino vertical entre ellas: la retícula de una agenda, no tres listas. */
  .plan { display:grid; grid-template-columns:1fr 1fr 1fr; border-top:var(--filete-fuerte);
          margin-top:1.5mm; }
  .plan .col { padding:1.6mm 3.2mm 0; }
  .plan .col:first-child { padding-left:0; }
  .plan .col:last-child { padding-right:0; }
  .plan .col + .col { border-left:var(--filete-fino); }
  .plan .plazo { font-family:var(--display); font-size:6.8pt; font-weight:600; letter-spacing:.18em;
                 text-transform:uppercase; color:var(--marca-tinta); padding-bottom:1.1mm;
                 margin-bottom:1.8mm; border-bottom:var(--filete-fino); }
  .plan .accion { position:relative; padding:0 0 1.8mm 6.4mm; }
  .plan .num { position:absolute; left:0; top:-.3mm; font-family:var(--display); font-size:12pt;
               font-weight:600; color:var(--ink); line-height:1; }
  .plan .que { display:block; font-weight:600; font-size:8.9pt; line-height:1.27; text-wrap:pretty; }
  .plan .cifra { display:block; color:var(--muted); font-size:8pt; line-height:1.3; margin-top:.5mm;
                 text-wrap:pretty; }

  /* ── Notas y pie ──────────────────────────────────────────────────────── */
  section { margin-bottom:2.6mm; }
  .note { font-size:7.9pt; line-height:1.38; color:var(--muted); border-left:2px solid var(--rule);
          padding-left:2.4mm; }
  .colofon { margin-top:2.5mm; }
  /* El pie cae a la misma altura en las dos páginas: el blanco que sobre queda arriba de él,
     en un solo hueco, y no repartido en dos. */
  footer {
    margin-top:auto; font-family:var(--mono); font-size:7.2pt; color:var(--muted);
    border-top:1px solid var(--ink); padding-top:1.6mm; display:flex; justify-content:space-between;
    align-items:baseline;
  }
  footer a { color:inherit; text-decoration:none; }
  footer .folio { color:var(--ink); font-weight:600; }
</style>
</head>
<body>

<div class="page" id="p1">
  <header>
    <div class="eyebrow"><span>{{ meta.cliente }}</span><span>{{ meta.fecha }}</span></div>
    <h1>{{ meta.titulo }}</h1>
  </header>

  <p class="verdict">{{ veredicto|safe }}</p>

  <p class="ask">{{ recomendacion }}</p>

  <section class="risk">
    <h2>{{ cumplimiento.rotulo }}</h2>
    <p class="caveat">{{ cumplimiento.salvedad }}</p>
    <table>
      <colgroup>
        <col style="width:5mm"><col style="width:64mm"><col style="width:14mm">
        <col style="width:17mm"><col style="width:58mm"><col>
      </colgroup>
      <thead><tr><th></th><th>Lo que se dijo</th><th class="num">IA</th><th class="num">Humanos</th>
        <th>Qué hacer</th><th>Norma</th></tr></thead>
      <tbody>
      {% for a in cumplimiento.filas %}
        <tr><td class="n">{{ loop.index }}</td>
            <td><span class="conducta">{{ a.conducta }}</span>{% if a.cita %}<span class="cita">«{{ a.cita }}»</span>{% endif %}</td>
            <td class="num">{{ a.ia }}</td><td class="num">{{ a.humano }}</td>
            <td><span class="accion">{{ a.accion }}</span><span class="arreglo">{{ a.arreglo }}</span></td>
            <td><span class="norma">{{ a.norma }}</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ cumplimiento.advertencia }}</p>
  </section>

  <section>
    <h2>Dónde difieren y dónde no</h2>
    {{ forest_svg|safe }}
    <p class="note">{{ forest_nota }}</p>
  </section>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span class="folio">1 / 2</span></footer>
</div>

<div class="page" id="p2">
  <header>
    <div class="eyebrow"><span>La llamada, de principio a fin</span><span>{{ meta.fecha }}</span></div>
  </header>

  <section class="journey">
    <h2 class="major">Hasta dónde llega la llamada y cómo queda quien contesta</h2>
    <p class="lead">{{ recorrido_lead }}</p>
    {{ recorrido_svg|safe }}
  </section>

  <section class="close">
    <h2 class="major">Qué hacer, en orden</h2>
    <div class="plan">
      {% for g in cierre %}
      <div class="col">
        <div class="plazo">{{ g.plazo }}</div>
        {% for a in g.acciones %}
        <div class="accion">
          <span class="num">{{ a.n }}</span>
          <span class="que">{{ a.que }}</span>
          <span class="cifra">{{ a.cifra }}</span>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>

  <p class="note colofon">{{ colofon }}</p>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span class="folio">2 / 2</span></footer>
</div>

</body>
</html>
