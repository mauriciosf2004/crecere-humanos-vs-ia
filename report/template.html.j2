<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ meta.titulo }}</title>
<style>
  /* Geometría: A4 con 12 mm de margen. La caja útil es 186 x 273 mm; se trabaja
     sobre 255 mm de alto para dejar aire y que nada quede al filo del corte. */
  @page { size: A4; margin: 12mm; }
  :root {
    --ink:#16161a; --muted:#6b6b75; --line:#e2e0e6; --bg:#fff;
    --ai:#7047EB; --human:#F26ECF; --null:#9a97a3;
    --pos:#7047EB; --neg:#c2410c;
  }
  * { box-sizing:border-box; }
  html { -webkit-print-color-adjust:exact; print-color-adjust:exact; color-scheme:light; }
  body {
    margin:0; background:#f4f3f6; color:var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size:9.6pt; line-height:1.38; font-variant-numeric: tabular-nums lining-nums;
  }
  /* Sin overflow:hidden y con el pie en el flujo normal, a propósito: si el contenido
     desborda, fluye a una tercera página y `make verify` lo caza, en vez de recortarse o
     de quedar tapado por un pie posicionado encima. */
  .page {
    width:186mm; min-height:255mm; padding:0; margin:8mm auto; background:var(--bg);
    display:flex; flex-direction:column;
  }
  @media print {
    body { background:#fff; }
    .page { margin:0; width:auto; min-height:268mm; break-after:page; }
    .page:last-child { break-after:auto; }
  }
  h1 { text-wrap:balance; font-size:19pt; line-height:1.08; letter-spacing:-.022em; margin:0 0 3mm; }
  h2 { font-size:9.4pt; letter-spacing:.05em; text-transform:uppercase;
       color:var(--muted); margin:0 0 1.8mm; font-weight:650; }
  p { margin:0 0 1.8mm; }
  .eyebrow { font-size:8pt; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }
  .verdict { font-size:11pt; line-height:1.3; margin:0 0 4mm; }
  .verdict strong { font-weight:680; }
  header { border-bottom:1.5px solid var(--ink); padding-bottom:2.5mm; margin-bottom:4mm; }

  .kpis { display:grid; grid-template-columns:repeat({{ kpis|length }},1fr); gap:3mm; margin-bottom:4mm; }
  .kpi { border-top:2.5px solid var(--ai); padding-top:1.5mm; }
  .kpi .v { font-size:15pt; font-weight:680; letter-spacing:-.03em; display:block; line-height:1.05; }
  .kpi .l { font-size:8pt; color:var(--muted); display:block; margin-top:.8mm; }

  ol.findings { margin:0; padding:0; list-style:none; counter-reset:f; }
  ol.findings li { counter-increment:f; padding:1.3mm 0 1.3mm 8mm; border-bottom:1px solid var(--line);
                   position:relative; }
  ol.findings li:last-child { border-bottom:0; }
  ol.findings li::before { content:counter(f); position:absolute; left:0; top:1.4mm;
    font-size:8pt; font-weight:700; color:var(--ai); border:1.2px solid var(--ai);
    width:5mm; height:5mm; border-radius:50%; display:grid; place-items:center; }
  ol.findings .claim { font-weight:620; }
  ol.findings .why { color:var(--muted); }
  ol.findings .action { display:block; margin-top:.6mm; font-size:8.8pt; color:var(--ai); }

  table { width:100%; border-collapse:collapse; font-size:8.4pt; }
  th { text-align:left; font-weight:620; color:var(--muted); font-size:7.6pt;
       text-transform:uppercase; letter-spacing:.05em; padding:.9mm 1.4mm; border-bottom:1px solid var(--ink); }
  td { padding:.85mm 1.4mm; border-bottom:1px solid var(--line); vertical-align:top; }
  td.num, th.num { text-align:right; white-space:nowrap; }
  .tag { font-size:7.4pt; padding:.3mm 1.2mm; border-radius:2px; background:#f0eef5; color:var(--muted);
         white-space:nowrap; }
  .tag.ok { background:#e8f3ee; color:#2f6f53; }
  .tag.ko { background:#fbeee6; color:#9a3412; }
  .tag.warn { background:#fdf1dc; color:#8a5300; }

  svg.forest { width:100%; height:auto; }
  .forest .axis-zero { stroke:var(--ink); stroke-width:1; }
  .forest .axis-tick { stroke:var(--line); stroke-width:1; }
  .forest .axis-label, .forest .axis-title { font-size:7.2px; fill:var(--muted); text-anchor:middle; }
  .forest .row-label { font-size:8.4px; fill:var(--ink); text-anchor:end; }
  .forest .row-value { font-size:8.4px; font-weight:650; text-anchor:end; }
  .forest .ci { stroke-width:1.6; stroke-linecap:round; }
  .forest .ci.pos, .forest .pt.pos, .forest .row-value.pos { stroke:var(--pos); fill:var(--pos); }
  .forest .ci.neg, .forest .pt.neg, .forest .row-value.neg { stroke:var(--neg); fill:var(--neg); }
  .forest .ci.null, .forest .pt.null, .forest .row-value.null { stroke:var(--null); fill:var(--null); }

  .forest circle.pt.tentative { fill:#fff; stroke-width:1.6; }
  .forest line.ci.tentative { stroke-dasharray:3 2; }
  /* tabla estrecha: con solo dos cifras por fila, a ancho completo quedaban lejos de su etiqueta */
  table.compact { width:62%; }
  ul.levers { margin:0; padding-left:4mm; }
  ul.bullets { margin:0; padding-left:3.5mm; }
  ul.bullets li { margin-bottom:1mm; }
  .kpi.null { border-top-color:var(--null); }
  .kpi.neg { border-top-color:var(--neg); }
  footer a { color:inherit; text-decoration:none; }
  .kpi.null .v { color:var(--muted); }
  /* el color de la cifra va en el relleno: con trazo, el texto sale contorneado */
  .forest .row-value.pos, .forest .row-value.neg, .forest .row-value.null { stroke:none; }
  ul.levers li { margin-bottom:1.1mm; }
  .note { font-size:8pt; color:var(--muted); border-left:2px solid var(--line); padding-left:2.5mm; }
  footer { margin-top:auto; font-size:7.6pt; color:var(--muted);
           border-top:1px solid var(--line); padding-top:1.5mm; display:flex; justify-content:space-between; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:5mm; }
  section { margin-bottom:2.8mm; }
</style>
</head>
<body>

<div class="page" id="p1">
  <header>
    <div class="eyebrow">{{ meta.cliente }} · {{ meta.fecha }}</div>
    <h1>{{ meta.titulo }}</h1>
  </header>

  <p class="verdict">{{ veredicto|safe }}</p>

  <div class="kpis">
    {% for k in kpis %}<div class="kpi {{ k.clase }}"><span class="v">{{ k.valor }}</span><span class="l">{{ k.etiqueta }}</span></div>{% endfor %}
  </div>

  <section>
    <h2>Dónde difieren, y cuánto</h2>
    {{ forest_svg|safe }}
    <p class="note">{{ forest_nota }}</p>
  </section>

  <section>
    <h2>Hallazgos</h2>
    <ol class="findings">
      {% for f in hallazgos %}
      <li><span class="claim">{{ f.claim }}</span> <span class="why">{{ f.why }}</span>
        <span class="action">→ {{ f.accion }}</span></li>
      {% endfor %}
    </ol>
  </section>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span>1 / 2</span></footer>
</div>

<div class="page" id="p2">
  <header>
    <div class="eyebrow">Evidencia y método</div>
  </header>

  <section>
    <h2>Hipótesis y resultado</h2>
    <table>
      <thead><tr><th>Conducta</th><th>Sentido esperado</th><th class="num">IA</th><th class="num">Humano</th>
        <th class="num">Diferencia, pp [IC 95 %]</th><th class="num">p ajustado</th><th>Resultado</th></tr></thead>
      <tbody>
      {% for r in tabla %}
        <tr><td>{{ r.variable }}</td><td>{{ r.esperado }}</td><td class="num">{{ r.ia }}</td>
            <td class="num">{{ r.humano }}</td><td class="num">{{ r.diff }}</td><td class="num">{{ r.p }}</td>
            <td><span class="tag {{ r.estado_clase }}">{{ r.estado }}</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ tabla_nota }}</p>
  </section>

  <section>
    <h2>¿Eran llamadas comparables?</h2>
    <table class="compact">
      <thead><tr><th>Contexto de la llamada</th><th class="num">IA</th><th class="num">Humano</th></tr></thead>
      <tbody>
      {% for c in composicion %}
        <tr><td>{{ c.etiqueta }}</td><td class="num">{{ c.ia }}</td><td class="num">{{ c.humano }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note">{{ composicion_nota|safe }}</p>
  </section>

  <div class="grid2">
    <section>
      <h2>Método</h2>
      <ul class="bullets">{% for m in metodo %}<li>{{ m|safe }}</li>{% endfor %}</ul>
    </section>
    <section>
      <h2>Qué no se pudo medir</h2>
      <ul class="bullets">{% for l in limitaciones %}<li>{{ l|safe }}</li>{% endfor %}</ul>
    </section>
  </div>

  <section>
    <h2>Siguiente paso</h2>
    <ul class="levers">
      {% for p in palancas %}<li><strong>{{ p.titulo }}</strong> {{ p.detalle }}</li>{% endfor %}
    </ul>
  </section>

  <footer><span>{{ meta.autor }} · <a href="https://{{ meta.repositorio }}">{{ meta.repositorio }}</a></span><span>2 / 2</span></footer>
</div>

</body>
</html>
